# Copy to .env for local use, or add these as Replit Secrets. NEVER commit real keys.
YDC_API_KEY=
ANTHROPIC_API_KEY=

# auto (default): demo mode if either key is missing | on | off
DEMO_MODE=auto
ENABLE_DEMO=1

# Optional
CLAUDE_MODEL=claude-sonnet-5-5
RESEARCH_EFFORT=lite
RESEARCH_TIMEOUT=60
DEMO_CLEAN_PRODUCT=Graco Pack 'n Play Playard
